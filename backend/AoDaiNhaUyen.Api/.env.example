# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL local database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aodai_nha_uyen;Username=postgres;Password=postgres

# JWT. Replace with a long random secret in real environments.
JwtSettings__SecretKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=AoDaiNhaUyen.Api
JwtSettings__Audience=AoDaiNhaUyen.Frontend
JwtSettings__ExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=30

# Frontend origins allowed by CORS. Semicolon/comma separated values are supported.
FrontendOrigins=http://localhost:5173;http://127.0.0.1:5173;http://localhost:5174;http://127.0.0.1:5174;http://localhost:4173;http://127.0.0.1:4173

# Run EF migrations + seed data on API startup in local/dev.
RunMigrationsAndSeedOnStartup=true

# Email / SMTP
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=
EmailSettings__SmtpPassword=
EmailSettings__EnableSsl=true
EmailSettings__FromEmail=
EmailSettings__FromName=Ao Dai Nha Uyen
EmailSettings__ApiBaseUrl=http://localhost:5043
EmailSettings__FrontendBaseUrl=http://localhost:5173

# Google OAuth
GoogleOAuth__ClientId=
GoogleOAuth__ClientSecret=
GoogleOAuth__RedirectUri=http://localhost:5173/auth/google/callback

# Zalo OAuth
ZaloOAuth__AppId=
ZaloOAuth__SecretKey=
ZaloOAuth__RedirectUri=http://localhost:5173/auth/callback/zalo

# Google Cloud / AI features
GoogleCloud__ProjectId=
GoogleCloud__ApiKey=
GoogleCloud__Location=us-central1
GoogleCloud__VirtualTryOnModel=gemini-3.1-flash-image-preview
GoogleCloud__StylistTextModel=gemini-3.1-flash-lite-preview
GoogleCloud__TimeoutSeconds=1200


# Admin seed user (created on startup if not exists)

AdminSeed__Email=

AdminSeed__Password=

S3STORAGE__BUCKETNAME=
S3STORAGE__REGION=
S3STORAGE__ACCESSKEY=
S3STORAGE__SECRETKEY=
S3STORAGE__SERVICEURL=
S3STORAGE__USEPATHSTYLE=true
S3STORAGE__DEFAULTPRESIGNEDURLEXPIRATIONINSECONDS=3600

# Static/cache busting
CacheSettings__Version=v1
