# Backend API URL used by frontend fetch client
VITE_API_BASE_URL=http://localhost:5043

# Backend domain fallback. Keep same as VITE_API_BASE_URL for local dev.
PUBLIC_BACKEND_DOMAIN=http://localhost:5043

# OAuth public IDs. Safe to expose, but keep secrets only in backend .env.
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_ZALO_APP_ID=
